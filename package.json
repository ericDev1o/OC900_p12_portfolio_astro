{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.3",
  "scripts": {
    "update": "pnpm update --interactive",
    "weigh:js": "gzip -c dist/assets/*.js | wc -c",
    "weigh:css": "gzip -c dist/assets/*.css | wc -c",
    "migrate": "pnpm biome migrate --write",
    "lint": "biome check --fix .",
    "format": "biome format --write .",
    "pw:install": "playwright install && playwright install-deps",
    "test:integration": "playwright test test/integration/Home.integration.test.tsx",
    "test:e2e": "playwright test test/accessibility",
    "test:perf": "playwright test test/performance --config=playwright.perf.config.ts",
    "dev": "astro dev",
    "build": "astro build --timings",
    "build:scripts": "tsc --noEmit --runExternalCode -p tsconfig.scripts.json",
    "preview": "astro preview",
    "astro": "astro",
    "install": "pnpm install --frozen-lockfile",
    "audit": "pnpm audit",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.5",
    "gh-pages": "^6.3.0",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.1.0-beta"
  }
}
