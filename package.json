{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.2",
  "scripts": {
    "weigh:js": "gzip -c dist/assets/*.js | wc -c",
    "weigh:css": "gzip -c dist/assets/*.css | wc -c",
    "lint": "eslint --fix .",
    "pw:install": "playwright install && playwright install-deps",
    "test:integration": "playwright test test/integration/Home.integration.test.tsx",
    "test:e2e": "playwright test test/accessibility",
    "test:perf": "playwright test test/performance --config=playwright.perf.config.ts",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "preview": "astro preview",
    "astro": "astro",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d dist -b gh-pages --dotfiles"
  },
  "dependencies": {
    "astro": "^6.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "^0.2.1",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "packageManager": "yarn@4.16.0"
}
